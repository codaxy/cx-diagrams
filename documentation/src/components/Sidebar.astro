---
import NavItem from './NavItem.astro';
import { navigation } from '../data/navigation.js';
---

<nav id="sidebar" class="hidden pt-3 overflow-auto bg-white xl:border-r xl:block">
  {navigation.map((group, index) => (
    <>
      <div class:list={["px-6 py-2 text-sm font-bold text-gray-700", { "mt-2": index > 0 }]}>{group.title}</div>
      {group.items.map((item) => (
        <NavItem text={item.text} href={item.href} icon={group.icon} />
      ))}
    </>
  ))}
</nav>
